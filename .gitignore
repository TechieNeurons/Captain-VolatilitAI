# ----------------------------------------------------------------------
# Captain-VolAI / Captain-VolatilitAI - GitIgnore
# ----------------------------------------------------------------------

# Exclude all generated JSON artifact files (Contains sensitive PII/Malware data)
*.json

# Exclude massive memory dump files
*.dmp
*.raw
*.vmem
*.img
*.bin
*.mem

# Python standard exclusions
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
.env/

# IDE / OS specific files
.vscode/
.idea/
.DS_Store
Thumbs.db
